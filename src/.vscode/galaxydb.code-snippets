	// ---------------------------------------------------------
	// SELECT
	// ---------------------------------------------------------
	"galaxy.select": {
		"prefix": "galaxy.select",
		"description": "GalaxyDB → SELECT completo",
		"body": [
			"\\$${1:db} = new galaxyDB();",
			"\\$${1:db}->connect();",
			"\\$${1:db}->table(\"${2:TABELA}\");",
			"\\$${1:db}->colum(\"${3:*}\");",
			"\\$${1:db}->where('${4:coluna}', ${5:valor});",
			"\\$${1:db}->prepare_select('${6:param}');",
			"\\$${1:db}->transaction(function(\\$error) { die(\\$error); });",
			"\\$${1:db}->execQuery(function(\\$success) {});",
			"\\$_RESULT = \\$${1:db}->fetch_array('${6:param}');",
			"$0"
		]
	},

	"galaxy.select.join": {
		"prefix": "galaxy.select.join",
		"description": "GalaxyDB → SELECT com JOIN",
		"body": [
			"\\$${1:db} = new galaxyDB();",
			"\\$${1:db}->connect();",
			"\\$${1:db}->table(\"${2:TABELA} AS ${3:T1}\");",
			"\\$${1:db}->colum(\"${3:T1}.*\");",
			"\\$${1:db}->join('${4|INNER,LEFT,RIGHT|}', '${5:TABELA2} AS ${6:T2}', '${6:T2}.${7:ID} = ${3:T1}.${8:FK}');",
			"\\$${1:db}->where('${9:coluna}', ${10:valor});",
			"\\$${1:db}->prepare_select('${11:param}');",
			"\\$${1:db}->transaction(function(\\$error) { die(\\$error); });",
			"\\$${1:db}->execQuery(function(\\$success) {});",
			"\\$_RESULT = \\$${1:db}->fetch_array('${11:param}');",
			"$0"
		]
	},

