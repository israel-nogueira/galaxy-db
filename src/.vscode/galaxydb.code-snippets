	// ---------------------------------------------------------
	// INSERT
	// ---------------------------------------------------------
	"galaxy.insert": {
		"prefix": "galaxy.insert",
		"description": "GalaxyDB → INSERT completo",
		"body": [
			"\\$${1:db} = new galaxyDB();",
			"\\$${1:db}->connect();",
			"\\$${1:db}->table(\"${2:TABELA}\");",
			"\\$${1:db}->${3:COLUNA} = ${4:valor};",
			"\\$${1:db}->prepare_insert('${5:param}');",
			"\\$${1:db}->transaction(function(\\$error) { die(\\$error); });",
			"\\$${1:db}->execQuery(function(\\$success) {});",
			"\\$_ID = \\$${1:db}->_last_id['${5:param}'];",
			"$0"
		]
	},

	"galaxy.insert.batch": {
		"prefix": "galaxy.insert.batch",
		"description": "GalaxyDB → INSERT em lote",
		"body": [
			"\\$${1:db} = new galaxyDB();",
			"\\$${1:db}->connect();",
			"\\$${1:db}->table(\"${2:TABELA}\");",
			"\\$${1:db}->insertBatch([",
			"\t['${3:coluna}' => ${4:valor1}],",
			"\t['${3:coluna}' => ${5:valor2}],",
			"]);",
			"$0"
		]
	},

	"galaxy.insert.duplicate": {
		"prefix": "galaxy.insert.duplicate",
		"description": "GalaxyDB → INSERT ON DUPLICATE KEY UPDATE",
		"body": [
			"\\$${1:db} = new galaxyDB();",
			"\\$${1:db}->connect();",
			"\\$${1:db}->table(\"${2:TABELA}\");",
			"\\$${1:db}->${3:COLUNA} = ${4:valor};",
			"\\$${1:db}->on_duplicate();",
			"\\$${1:db}->prepare_insert('${5:param}');",
			"\\$${1:db}->clear();",
			"\\$${1:db}->transaction(function(\\$error) { die(\\$error); });",
			"\\$${1:db}->execQuery(function(\\$success) {});",
			"$0"
		]
	},

